# ==========================================
# SHOPCART B2B - CONFIGURAÇÃO DE AMBIENTE (BACKEND API)
# ==========================================

# URL Base da API do Backend (Spring Boot na porta 8080)
# Se deixado em branco, utiliza as rotas internas /api do Next.js (Modo Standalone/Demo)
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Nome da Aplicação
NEXT_PUBLIC_APP_NAME="Shopcart B2B Marketplace"

# URL da BrasilAPI para consulta oficial de CNPJ na Receita Federal
NEXT_PUBLIC_BRASIL_API_URL=https://brasilapi.com.br/api

# Timeout padrão de requisições HTTP (em milissegundos)
NEXT_PUBLIC_API_TIMEOUT_MS=15000
